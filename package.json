{
  "name": "swcc-desktop",
  "productName": "SWCC",
  "version": "0.1.0",
  "private": true,
  "description": "Private offline continuing competence year portfolios",
  "author": "SWCC",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prototype": "node scripts/prototype.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src tests scripts *.ts *.mjs",
    "build": "tsc -p tsconfig.main.json && vite build",
    "test": "node scripts/test.mjs",
    "test:desktop": "npm run build && playwright test",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "main": "dist/main/index.js",
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "better-sqlite3": "12.11.1",
    "lucide-react": "1.66.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yazl": "3.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "38.8.6",
    "electron-builder": "26.18.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "org.swcc.desktop",
    "productName": "SWCC",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sources/Code-of-Ethics-and-Standards-of-Practice-September-7-2018.pdf",
        "to": "sources/ethics-2018.pdf"
      },
      {
        "from": "resources/templates/annual-forms.pdf",
        "to": "templates/annual-forms.pdf"
      },
      {
        "from": "resources/fonts",
        "to": "fonts"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "14.0",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "perMachine": false
    }
  }
}
